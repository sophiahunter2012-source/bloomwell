<section class="reviews" id="reviews" data-preset="reviews" aria-labelledby="reviews-title">
  <div class="section-head reviews-head">
    <div>
      <p class="eyebrow">Reviews</p>
      <h2 id="reviews-title" class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.note != blank -%}<p class="reviews-note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
    <div class="review-nav">
      <button type="button" class="round-btn" data-dir="-1" aria-label="Previous reviews"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="round-btn" data-dir="1" aria-label="Next reviews"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </div>
  <ul class="review-track" role="list" tabindex="0" aria-label="Customer reviews">
    {%- for block in section.blocks -%}
      <li class="review" {{ block.shopify_attributes }}>
        <div class="review-top"><span class="stars" role="img" aria-label="{{ block.settings.rating }} out of 5 stars">{%- for i in (1..block.settings.rating) -%}<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{%- endfor -%}</span>{% if block.settings.example %}<span class="example-tag">Example</span>{% endif %}</div>
        <blockquote>“{{ block.settings.quote }}”</blockquote>
        <p class="review-meta"><span class="review-name">{{ block.settings.name }}</span> {% if block.settings.product != blank %}<span class="review-product">on {{ block.settings.product }}</span>{% endif %}</p>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "div",
  "class": "bw-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by the Bloomwell community"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note (clear this once reviews are real)",
      "default": "These are example reviews to show the layout. Real customer reviews will appear here."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "Write the customer's review here."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Sample customer"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": ""
        },
        {
          "type": "checkbox",
          "id": "example",
          "label": "Mark as example",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
