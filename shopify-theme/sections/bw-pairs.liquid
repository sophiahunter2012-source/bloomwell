  </ul>
</section>

{% schema %}
{
  "name": "Perfect pairs",
  "tag": "div",
  "class": "bw-section",
  "settings": [
    {
      "type": "range",
      "id": "discount",
      "label": "Pair discount shown",
      "info": "Create a matching automatic discount in Shopify first.",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Perfect pairs"
    }
  ]
}
{% endschema %}
