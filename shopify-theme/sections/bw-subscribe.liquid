<section class="subscribe" id="subscribe" aria-labelledby="subscribe-title">
      <div class="subscribe-inner">
        <div class="subscribe-copy">
          <p class="eyebrow">Subscribe &amp; save</p>
          <h2 id="subscribe-title" class="h2">Never run out of your ritual</h2>
          <p class="lede">Save 20% on every order when you subscribe to any product or bundle.</p>
        </div>
        <ol class="steps">
          <li><span class="step-num">1</span><h3>Pick your ritual</h3><p>Any product or bundle, any flavour.</p></li>
          <li><span class="step-num">2</span><h3>Choose your rhythm</h3><p>Delivered every 30, 60 or 90 days.</p></li>
          <li><span class="step-num">3</span><h3>Save 20%, always</h3><p>Skip, swap or cancel any time from your account.</p></li>
        </ol>
      </div>
    </section>

{% schema %}
{
  "name": "Subscribe & save",
  "tag": "div",
  "class": "bw-section",
  "presets": [
    {
      "name": "Subscribe & save"
    }
  ]
}
{% endschema %}
