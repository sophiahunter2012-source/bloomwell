</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "div",
  "class": "bw-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rituals, ready-made"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Our favourite routines in one box."
    },
    {
      "type": "range",
      "id": "discount",
      "label": "Bundle discount shown (%). Create a matching automatic discount in Shopify first.",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Bundles"
    }
  ]
}
{% endschema %}
