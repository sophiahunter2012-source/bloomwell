<section class="bundles" id="bundles" data-preset="bundles" aria-labelledby="bundles-title">
  <div class="section-head">
    <p class="eyebrow">Bundle &amp; save</p>
    <h2 id="bundles-title" class="h2">{{ section.settings.heading }}</h2>
    <p class="lede">{{ section.settings.text }}</p>
  </div>
  <div class="bundle-grid">
      {%- liquid
  assign total = 0
  assign ids = ''
  assign handles = 'skin-sip-collagen-hyaluronic-acid,daily-glow-adult-multivitamin-gummies,daily-nourish-lip-balm,hand-cream' | split: ','
  for h in handles
    assign p = all_products[h]
    if p.id
      assign v = p.selected_or_first_available_variant
      assign total = total | plus: v.price
      assign ids = ids | append: v.id | append: ','
    endif
  endfor
  assign d = section.settings.discount
  assign now = total
  if d > 0
    assign off = total | times: d | divided_by: 100
    assign now = total | minus: off
  endif
-%}
      <article class="bundle" style="--tint:#FBE2DA">
        <div class="bundle-stack n4" aria-hidden="true"><img src="{{ 'skin-sip-sm.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy"><img src="{{ 'daily-glow-sm.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy"><img src="{{ 'lip-balm-sm.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy"><img src="{{ 'hand-cream-sm.webp' | asset_url }}" alt="" width="600" height="600" loading="lazy"></div>
        <div class="bundle-body">
          {%- if d > 0 -%}<span class="save-pill">Save {{ d }}%</span>{%- endif -%}
          <h3>The Glow Ritual</h3>
          <p class="bundle-items">Skin Sip, Daily Glow, Lip Balm &amp; Hand Cream</p>
          <p class="price"><span class="price-now">{{ now | money }}</span>{% if d > 0 %} <s class="price-was">{{ total | money }}</s>{% endif %}</p>
          <button type="button" class="btn btn-block" data-add-items="{{ ids }}">Add bundle to bag</button>
        </div>
      </article>
