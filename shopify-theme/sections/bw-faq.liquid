<section class="c-faq" aria-labelledby="faq-title-{{ section.id }}">
  <div class="c-faq-inner">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="faq-title-{{ section.id }}" class="h2">{{ section.settings.heading }}</h2>
    <div class="c-faq-list">
      {%- for block in section.blocks -%}
        <details class="c-faq-item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary><span>{{ block.settings.question }}</span><span class="c-faq-icon" aria-hidden="true"></span></summary>
          <div class="c-faq-answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQs",
  "tag": "div",
  "class": "bw-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions, answered"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs"
    }
  ]
}
{% endschema %}
